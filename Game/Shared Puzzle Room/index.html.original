<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">A1</button>
<button class="w-10 h-10 rounded bg-surface-container-high text-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow transition-transform active:scale-95 z-10 hover:bg-surface-variant" type="button">A2</button>
<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">A3</button>
<button class="w-10 h-10 rounded bg-surface-container-high text-outline font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow transition-transform active:scale-95 z-10 hover:bg-surface-variant" type="button">A4</button>
<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">B1</button>
<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">B2</button>
<button class="w-10 h-10 rounded bg-surface-container-high text-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow transition-transform active:scale-95 z-10 hover:bg-surface-variant" type="button">B3</button>
<button class="w-10 h-10 rounded bg-surface-container-high text-outline font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow transition-transform active:scale-95 z-10 hover:bg-surface-variant" type="button">B4</button>
<button class="w-10 h-10 rounded bg-surface-container-high text-outline font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow transition-transform active:scale-95 z-10 hover:bg-surface-variant" type="button">C1</button>
<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">C2</button>
<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">C3</button>
<button class="w-10 h-10 rounded bg-primary text-on-primary font-telemetry-sm text-telemetry-sm font-bold flex items-center justify-center shadow-lg transition-transform active:scale-95 z-10" type="button">C4</button>
</div>
</div>
<!-- Harmonic Frequency Waveform Visualizer -->
<div class="bg-surface-container p-space-sm rounded-lg flex flex-col space-y-space-xs shadow-inner">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps text-outline">FREQUENCY CARRIER WAVE</span>
<span class="font-telemetry-sm text-telemetry-sm text-primary font-bold">RES-LOCK: ACTIVE</span>
</div>
<div class="h-16 w-full bg-surface-container-lowest rounded flex items-center px-space-xs overflow-hidden">
<svg class="w-full h-12 text-primary" fill="none" preserveaspectratio="none" viewbox="0 0 300 48">
<path d="M0,24 Q25,2 50,24 T100,24 T150,24 T200,24 T250,24 T300,24" fill="none" stroke="currentColor" stroke-width="2"></path>
<path d="M0,24 Q25,44 50,24 T100,24 T150,24 T200,24 T250,24 T300,24" fill="none" opacity="0.35" stroke="currentColor" stroke-width="1"></path>
</svg>
</div>
</div>
<!-- Tactile Hardware Switches & Rotary Dials -->
<div class="bg-surface-container-high p-space-md rounded-lg space-y-space-md shadow-md">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps text-on-surface uppercase tracking-wider">Auxiliary Switches</span>
<span class="font-telemetry-sm text-telemetry-sm text-outline">BANK 01-A</span>
</div>
<div class="grid grid-cols-3 gap-space-sm">
<!-- Toggle 1 -->
<div class="bg-surface-container-low p-space-sm rounded flex flex-col items-center gap-space-xs shadow-inner">
<span class="font-label-caps text-label-caps text-outline">GATE_TX</span>
<div class="w-12 h-6 bg-primary/20 rounded-full p-0.5 flex items-center justify-end cursor-pointer shadow-inner">
<div class="w-5 h-5 rounded-full bg-primary shadow-md"></div>
</div>
<span class="font-telemetry-sm text-telemetry-sm text-primary font-bold">ARMED</span>
</div>
<!-- Toggle 2 -->
<div class="bg-surface-container-low p-space-sm rounded flex flex-col items-center gap-space-xs shadow-inner">
<span class="font-label-caps text-label-caps text-outline">PHASE_ST</span>
<div class="w-12 h-6 bg-surface-container-highest rounded-full p-0.5 flex items-center justify-start cursor-pointer shadow-inner">
<div class="w-5 h-5 rounded-full bg-outline shadow-md"></div>
</div>
<span class="font-telemetry-sm text-telemetry-sm text-outline">STBY</span>
</div>
<!-- Rotary Dial Indicator -->
<div class="bg-surface-container-low p-space-sm rounded flex flex-col items-center gap-space-xs shadow-inner">
<span class="font-label-caps text-label-caps text-outline">POT_CAL</span>
<div class="w-7 h-7 rounded-full bg-surface-container-highest relative flex items-center justify-center shadow">
<div class="w-1 h-3.5 bg-primary rounded-full absolute -top-0.5"></div>
</div>
<span class="font-telemetry-sm text-telemetry-sm text-primary font-bold">+18 dB</span>
</div>
</div>
<!-- Slider Levers with Calibration Ticks -->
<div class="space-y-1">
<div class="flex justify-between font-label-caps text-label-caps text-outline">
<span>MODULATION COEF</span>
<span class="text-primary font-telemetry-sm text-telemetry-sm">74.2%</span>
</div>
<div class="w-full bg-surface-container-lowest h-3 rounded relative flex items-center px-1 shadow-inner">
<div class="h-1 bg-primary w-3/4 rounded"></div>
<div class="w-3 h-5 bg-on-surface rounded shadow -ml-1 cursor-grab"></div>
</div>
<div class="flex justify-between px-0.5 font-label-caps text-label-caps text-outline-variant">
<span>0</span><span>25</span><span>50</span><span>75</span><span>100</span>
</div>
</div>
</div>
<!-- Action Button -->
<button class="w-full py-space-sm px-space-md bg-primary text-on-primary rounded font-label-caps text-label-caps uppercase font-bold tracking-widest hover:bg-primary-container hover:text-on-primary-container active:scale-[0.99] transition-all flex items-center justify-center gap-space-xs shadow-xl shadow-primary/20" id="pulse-btn" type="button">
