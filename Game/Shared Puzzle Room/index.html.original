<!-- TOP DEPLOYMENT METADATA & TELEMETRY STRIP -->
<div class="flex flex-wrap items-center justify-between gap-gutter bg-surface-container-low p-space-md rounded-lg shadow-xl">
<div class="flex items-center gap-space-lg">
<div class="flex items-center gap-space-sm">
<span class="w-3 h-3 rounded-full bg-tertiary animate-ping"></span>
<span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">PROTOCOL: SIGMA-SYNCHRON</span>
</div>
<div class="h-4 w-px bg-outline-variant/30"></div>
<div class="flex items-center gap-space-xs font-telemetry-sm text-telemetry-sm text-on-surface-variant">
<span class="text-outline">POLARITY RATIO:</span>
<span class="text-primary font-bold">ALPHA: 51.2%</span>
<span class="text-outline">/</span>
<span class="text-secondary font-bold">BETA: 48.8%</span>
</div>
</div>
<div class="flex items-center gap-space-md">
<div class="flex items-center gap-space-xs px-space-sm py-0.5 rounded bg-surface-container-high">
<span class="font-label-caps text-label-caps text-tertiary">PHASE INTEGRITY:</span>
<span class="font-telemetry-sm text-telemetry-sm text-on-surface font-bold">OPTIMAL // LOCK_STAGE_03</span>
</div>
<div class="flex items-center gap-space-xs px-space-sm py-0.5 rounded bg-surface-container-high font-telemetry-sm text-telemetry-sm text-primary">
<span class="material-symbols-outlined text-body-sm animate-spin">cyclone</span>
<span>QUANTUM BUS: ENGAGED</span>
</div>
</div>
</div>
<!-- MAIN TRI-SECTION SYNCHRONIZED INTERFACE -->
<div class="grid grid-cols-1 xl:grid-cols-12 gap-gutter-desktop items-stretch">
<!-- LEFT PANEL: PLAYER 1 - CYAN (VEX-01) -->
<div class="xl:col-span-4 flex flex-col bg-surface-container-low/80 backdrop-blur-md rounded-xl p-space-md shadow-2xl space-y-space-md relative overflow-hidden group">
<!-- Glow Underlay Layer -->
<div class="absolute -top-24 -left-24 w-72 h-72 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
<!-- Header Alpha Console -->
<div class="flex items-center justify-between bg-surface-container-high/90 p-space-sm rounded shadow-sm">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-body-lg">tune</span>
<div class="flex flex-col">
<span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">CON_ALPHA // VEX-01</span>
<span class="font-headline-md text-headline-md text-on-surface leading-tight">Frequency Harmonic Tuner</span>
</div>
</div>
<div class="px-space-sm py-space-xs rounded bg-surface-container-lowest font-telemetry-sm text-telemetry-sm text-primary flex items-center gap-1.5 shadow-inner">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span>432.8 MHz</span>
</div>
</div>
<!-- Alpha Realtime Telemetry Readout -->
<div class="grid grid-cols-2 gap-space-sm">
<div class="bg-surface-container p-space-sm rounded flex flex-col shadow-inner">
<span class="font-label-caps text-label-caps text-outline">RELAY INTEGRITY</span>
<span class="font-telemetry-lg text-telemetry-lg text-primary font-bold">3/4 ENERGIZED</span>
<div class="w-full bg-surface-container-highest h-1 rounded mt-space-xs overflow-hidden">
<div class="h-full bg-primary w-3/4"></div>
</div>
</div>
<div class="bg-surface-container p-space-sm rounded flex flex-col shadow-inner">
<span class="font-label-caps text-label-caps text-outline">CORE OVERCHARGE</span>
<span class="font-telemetry-lg text-telemetry-lg text-on-surface font-bold">NOMINAL 22%</span>
<div class="w-full bg-surface-container-highest h-1 rounded mt-space-xs overflow-hidden">
<div class="h-full bg-primary/60 w-[22%]"></div>
</div>
</div>
</div>
<!-- Interactive Node Conduit Matrix -->
<div class="bg-surface-container-lowest/80 p-space-md rounded-lg flex flex-col space-y-space-sm shadow-inner">
<div class="flex items-center justify-between">
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Resonance Node Matrix</span>
<span class="font-telemetry-sm text-telemetry-sm text-primary">[POLARITY: AUTO]</span>
</div>
<!-- Interactive 4x4 Grid with SVG Conduits -->
<div class="relative bg-surface-container-low p-space-md rounded grid grid-cols-4 gap-space-md place-items-center" id="alpha-grid">
<!-- Ambient conduit connections SVG -->
<svg class="absolute inset-0 w-full h-full pointer-events-none text-primary" fill="none" preserveaspectratio="none" viewbox="0 0 240 160">
<path class="animate-pulse" d="M 30,30 L 90,30 L 90,90 L 150,90 L 210,130" opacity="0.6" stroke="currentColor" stroke-dasharray="4 2" stroke-width="2"></path>
<path d="M 30,90 L 90,90 L 150,30 L 210,30" opacity="0.3" stroke="currentColor" stroke-width="1.5"></path>
</svg>
