  (function() {
    const pulseBtn = document.getElementById('pulse-btn');
    const fluxBtn = document.getElementById('flux-btn');

    if (pulseBtn) {
      pulseBtn.addEventListener('click', () => {
        pulseBtn.classList.add('scale-95');
        setTimeout(() => pulseBtn.classList.remove('scale-95'), 150);
      });
    }

    if (fluxBtn) {
      fluxBtn.addEventListener('click', () => {
        fluxBtn.classList.add('scale-95');
        setTimeout(() => fluxBtn.classList.remove('scale-95'), 150);
      });
    }
  })();
