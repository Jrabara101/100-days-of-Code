surface-container-low/95 backdrop-blur-md z-40 flex flex-col border-r border-outline-variant/30"><div class="p-space-md flex flex-col gap-space-xs"><div class="flex items-center justify-between"><span class="font-label-caps text-label-caps text-outline uppercase">Subsystems Status</span><span class="font-telemetry-sm text-telemetry-sm text-tertiary">ONLINE</span></div><div class="h-1 w-full bg-surface-container-highest rounded overflow-hidden"><div class="h-full bg-primary w-3/4 animate-pulse"></div></div></div><nav class="flex-1 px-space-sm space-y-space-xs overflow-y-auto" data-active-classes="bg-surface-container-high text-primary font-bold border-l-2 border-primary"><a aria-current="page" class="flex items-center justify-between px-space-sm py-space-sm rounded transition-colors bg-surface-container-high text-primary font-bold border-l-2 border-primary" data-path="dual-sync-viewport" href="#"><span class="font-label-caps text-label-caps uppercase">01 // Viewport Sync</span><span class="font-telemetry-sm text-telemetry-sm text-outline">SYNC</span></a><a class="flex items-center justify-between px-space-sm py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-body-sm text-body-sm" data-path="matrix-puzzle-conduit" href="#"><span class="font-label-caps text-label-caps uppercase">02 // Matrix Grid</span><span class="font-telemetry-sm text-telemetry-sm text-secondary">LOCKED</span></a><a class="flex items-center justify-between px-space-sm py-space-sm rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors font-body-sm text-body-sm" data-path="tactical-sensor-feed" href="#"><span class="font-label-caps text-label-caps uppercase">03 // Biosensors</span><span class="font-telemetry-sm text-telemetry-sm text-primary">ACTV</span></a><a class="flex items-center justify-between px-space-sm py-space-sm rounded text-on-surface-variant hover:bg-surface-container-hi