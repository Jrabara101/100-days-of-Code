# Atelier Portfolio & Digital Garden Environment Variables
# If provided, the app seamlessly connects to your Supabase PostgreSQL cluster.
# If omitted, the app operates in resilient, zero-config local-first storage mode.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Admin Pin for the editorial studio cockpit (default: studio2026)
VITE_ADMIN_PIN=studio2026
